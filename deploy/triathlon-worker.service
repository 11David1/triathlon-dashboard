[Unit]
Description=Triathlon-Dashboard (Auswertung mit Claude, ohne Tools)
After=network.target triathlon-web.service

[Service]
# Braucht die Claude-Anmeldung aus /root/.claude, ist aber nicht aus dem Netz erreichbar.
User=root
Environment=HOME=/root
Environment=TZ=Europe/Berlin
WorkingDirectory=/opt/triathlon-dashboard
ExecStart=/opt/triathlon-dashboard/venv/bin/python -m app.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/triathlon-dashboard/data /root/.claude /root/.claude.json /root/.cache

[Install]
WantedBy=multi-user.target
